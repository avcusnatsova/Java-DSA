class Solution {
    public boolean isIsomorphic(String s, String t) {
        HashMap< Character, Character> first = new HashMap<>();
        HashMap< Character , Character> second = new HashMap<>();


        for(int i = 0; i < s.length(); i++){
            char c1 = s.charAt(i);
            char c2 = t.charAt(i);

            if(!first.containsKey(c1) && !second.containsKey(c2)){
first.put(c1, c2);
second.put(c2, c1);
            }
            else{
                if((first.getOrDefault(c1, '#') != c2) || (second.getOrDefault(c2, '#') != c1) ){
                    return false;
                }
            }
        }
        return true;
    }
}
