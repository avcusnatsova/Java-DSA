class Solution {
    public int threeSumSmaller(int[] nums, int target) {
system.out.println("Threesum smaller");
       int count = 0;
       int n = nums.length;
       Arrays.sort(nums);

for(int i = 0; i < n - 2; i++){
int left = i + 1;
int right = n - 1;

while(left < right){

int sum = nums[i] + nums[left] + nums[right];

if(sum < target){
count += (right - left);
left++;
}
else{
right--;
}
}
} 
        return count;
    }
}
