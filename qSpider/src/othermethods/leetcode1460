class Solution {
    public boolean canBeEqual(int[] target, int[] arr) {
        int[] countmap = new int [1001];
#mapping

        for(int i = 0; i < target.length; i++){
            countmap[target[i]]++;
            countmap[arr[i]]--;
        } 
        for(int i : countmap){
            if(i != 0){
                return false;
            }
        }
        return true;
    }
}
