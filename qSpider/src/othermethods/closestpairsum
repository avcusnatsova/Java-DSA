package arrays;
//Q8. Closest Pair Sum
/*
Problem:
Given a sorted integer array and a target,
find the pair whose sum is closest to the target.

Example:
Input:
arr = [1,3,5,7,9]
target = 10

Output:
3 7

Explanation:
3 + 7 = 10
*/



public class Closestpairsum {
	public int[] closestPair(int[] arr, int target) {

        int left = 0;
        int right = arr.length - 1;
        
        int mindiff = Integer.MAX_VALUE;
        
        int bestleft = -1;
        int bestright = -1;
        
        while(left < right) {
        	int sum = arr[left] + arr[right];
        	int diff = Math.abs(target - sum);
        	
        	if(diff < mindiff) {
        		mindiff = diff;
        		bestleft = left;
        		bestright = right;
        	}
        	if( sum > target) {
        		right--;
        	}
        	else if(sum < target){
        		left++;
        	}
        	else {
        		break;
        	}
        
        }

        return new int[] {bestleft,bestright};
    }

}
